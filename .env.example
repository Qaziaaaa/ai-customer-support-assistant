# Copy this file to `.env` and fill in your keys.
# Get a free Groq key (no credit card): https://console.groq.com/keys
GROQ_API_KEY=your_groq_key_here

# Get a free LangSmith key (no credit card): https://smith.langchain.com/settings
# Tracing stays off if this is missing — the app still runs.
LANGSMITH_API_KEY=your_langsmith_key_here
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=novamart-support
